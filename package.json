{
  "name": "dsh-team-flow-continuous",
  "version": "0.2.0-alpha.3",
  "private": true,
  "license": "MIT",
  "description": "Let user Steer end a single Agent Teams wait while teammates keep running.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-experimental-agent-team": "*",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-agent-team": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-tool-agent-team": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidekaixin2dian/dsh-team-flow.git"
  },
  "homepage": "https://github.com/jidekaixin2dian/dsh-team-flow#readme",
  "bugs": {
    "url": "https://github.com/jidekaixin2dian/dsh-team-flow/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "agent-teams",
    "steer"
  ],
  "types": "lib/index.d.ts",
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup:host": "node scripts/setup-host.mjs",
    "test": "node tests/run.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "pack:local": "node scripts/pack.mjs"
  }
}
